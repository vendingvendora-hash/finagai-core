{
  "name": "finagai-core",
  "version": "0.0.1",
  "private": true,
  "description": "Finagai Core: state, rules, pipelines, and audit history for the Finagai agent (Option B, ADR-013).",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc --version && tsc -p tsconfig.build.json --pretty false",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run test/unit",
    "verify:migrations": "bash scripts/verify-migrations.sh",
    "migrate": "bash scripts/migrate.sh",
    "test:integration": "bash scripts/test-integration.sh",
    "eval:j2": "bash scripts/eval-j2.sh",
    "admin": "node dist/src/admin/cli.js",
    "eval:j3": "bash scripts/eval-j3.sh",
    "preflight": "node dist/src/ops/preflight-cli.js",
    "verify:startup": "npm run build && bash scripts/verify-startup.sh",
    "provision": "npm run build >/dev/null && node dist/src/provision/cli.js",
    "finagai:build": "npm run build >/dev/null && node dist/src/agent/cli.js build",
    "finagai:resume": "npm run build >/dev/null && node dist/src/agent/cli.js resume",
    "finagai:status": "npm run build >/dev/null && node dist/src/agent/cli.js status",
    "finagai:fresh": "npm run build >/dev/null && node dist/src/agent/cli.js fresh"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.287",
    "@anthropic-ai/sdk": "^0.131.0",
    "@modelcontextprotocol/server": "^2.2.0",
    "@simplewebauthn/server": "^14.0.3",
    "jose": "^6.2.12",
    "libsodium-wrappers": "^0.8.4",
    "pg": "^8.23.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.2.0",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.23.1",
    "typescript": "^5.6.3",
    "vitest": "^2.1.8"
  }
}
