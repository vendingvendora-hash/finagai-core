# Finagai Core configuration. Copy to .env for LOCAL development only.
# Real values for deployed environments are set directly in the Render dashboard
# (environment group "finagai-core"), never committed, never pasted into Claude.
# Placeholders in angle brackets do not exist yet.

NODE_ENV=development
# deployed: https://<render-service-host>
FINAGAI_PUBLIC_BASE_URL=http://localhost:8787
# must equal the URL entered in claude.ai exactly
FINAGAI_MCP_RESOURCE_URL=http://localhost:8787/mcp
FINAGAI_TIMEZONE=America/New_York

# Database (Neon). App role only; the migrator role is never configured on the host.
DATABASE_URL=postgres://finagai_app:<local-password>@localhost:5432/finagai?sslmode=disable

# Anthropic API (dedicated "finagai" workspace)
ANTHROPIC_API_KEY=<set-in-render-dashboard>
MODEL_J2_EXTRACT=claude-sonnet-5-5
MODEL_J2_CLASSIFY=claude-sonnet-5-5
MODEL_J3_COMPOSE=claude-sonnet-5-5
MODEL_J3_SHADOW=claude-opus-5-5
MODEL_EVAL_GRADER=claude-opus-5-5
MODEL_BUDGET_TARGET_USD_MONTH=30
MODEL_HARD_CEILING_USD_MONTH=36
MAX_DEFERRED_CAPTURES=200

# Identity provider (WorkOS AuthKit, pending sign-off)
OAUTH_ISSUER=https://<authkit-subdomain>.authkit.app
OAUTH_JWKS_URL=https://<authkit-subdomain>.authkit.app/oauth2/jwks
PRINCIPAL_SUBJECT=<julian-workos-user-id>
APPROVAL_CLIENT_ID=<workos-approval-app-client-id>
# Pinned after the first M3 connection; empty means log-only
ALLOWED_MCP_CLIENT_IDS=
APPROVAL_CLIENT_SECRET=<set-in-render-dashboard>
SESSION_SECRET=<generated-by-render>

# Email (Resend)
RESEND_API_KEY=<set-in-render-dashboard>
NOTIFY_FROM=Finagai <review@<sending-subdomain>>
NOTIFY_TO=<julian-address>
NOTIFY_REPLY_TO=<julian-address>

# Operating defaults (ADR-026, ADR-022 proposed)
WEEKLY_REVIEW_DAY=1
WEEKLY_REVIEW_TIME=07:00
MISSED_RUN_CHECK_TIME=09:00
STALL_THRESHOLD_DAYS=14
UPCOMING_WINDOW_DAYS=14
PRIORITY_UPCOMING_WINDOW_DAYS=30
GOVERNANCE_REQUEST_TTL_HOURS=72
RETENTION_CONFIDENTIAL_THIRD_PARTY_DAYS=180
PUBLIC_PROFESSIONAL_REVERIFY_DAYS=365
PUBLIC_FACT_FRESHNESS_WARNING_DAYS=120
