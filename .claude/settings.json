{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Read(./.env)", "Read(./.env.*)", "Read(~/.ssh/**)", "Read(~/.aws/**)", "Read(~/.config/gh/**)",
      "Bash(env)", "Bash(printenv:*)", "Bash(sudo:*)", "Bash(curl:*)", "Bash(wget:*)", "Bash(ssh:*)",
      "Bash(git push --force:*)", "Bash(git push -f:*)", "Bash(gh auth token:*)", "Bash(npm run provision:*)", "Bash(npm run admin:*)"
    ]
  }
}
