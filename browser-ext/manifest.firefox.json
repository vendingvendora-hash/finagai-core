{
  "manifest_version": 3,
  "name": "Finagai Operator",
  "version": "1.0.0",
  "description": "Lets Finagai (Julian's own agent) read and operate pages in this browser through a local native channel. No cookies, no passwords.",
  "permissions": [
    "tabs",
    "scripting",
    "nativeMessaging",
    "downloads"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "operator@finagai.local",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
